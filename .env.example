# LABREX Environment Configuration Template
# COPY TO .env FOR LOCAL DEVELOPMENT (DO NOT COMMIT .env)

# Application Settings
ENVIRONMENT=LOCAL
DEBUG=true
APP_NAME="LABREX Intelligence Platform"
APP_VERSION=1.0.0

# Database Settings (Local PostgreSQL 16)
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_POSTGRES_PASSWORD@127.0.0.1:5432/labrex
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# Security & Authentication
JWT_SECRET_KEY=local_dev_secret_key_change_in_production_min_32_chars_long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# External Integrations (Optional for local demo mode)
GEMINI_API_KEY=
GCP_PROJECT_ID=
BIGQUERY_DATASET=labrex_gold
GCS_BUCKET_NAME=labrex-artifacts
